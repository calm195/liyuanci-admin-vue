{
  "name": "vue3-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/eslint/*.test.js",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "codex": "codex",
    "codex:login": "codex login"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "pinia": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "@vue/tsconfig": "0.9.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-vue": "10.11.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "vitest": "5.0.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "@openai/codex": "0.162.1"
  }
}
